# Copy to .env — never commit .env
# Names only. Values stay on your machine.
# Read-only research keys only. See docs/SENSITIVE-INTEGRATIONS.md
#
# Do not add: swap/router keys, CEX trading keys, withdraw keys,
# wallet spend keys, X/Twitter posting tokens, WordPress passwords.

# Optional even on free tiers
# COINGECKO_DEMO_KEY=

# Optional / paid — leave blank; adapters must DARK
# DEFILLAMA_PRO_KEY=
# HELIUS_API_KEY=
# BIRDEYE_API_KEY=
# GMGN_API_KEY=
# NANSEN_API_KEY=
# ARKHAM_API_KEY=
# CRYPTOQUANT_API_KEY=
# GLASSNODE_API_KEY=
# TIINGO_API_KEY=
